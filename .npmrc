# @deriv-com/smartcharts-champion 1.12.0 asks for quill-ui ^1.24.9 as a peer,
# while this project pins quill-ui 1.18.1 - the pair the app is built and
# tested against. npm 7+ treats that as a hard error and aborts the install,
# which is what broke deploys. Keep peer resolution legacy so a host installs
# exactly what the lockfile already pins.
legacy-peer-deps=true
